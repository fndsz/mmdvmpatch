+-- Returns lastheard entries grouped by mode (DMR Slot 1, DMR Slot 2, etc.)
+-- Each mode keeps up to 'limit' entries for history display
+function get_lastheard_by_mode(limit)
+	limit = limit or 25
+	local loglines = get_mmdvm_log()
+	local headlist = get_hearlist(loglines)
+
+	-- Deduplicate by callsign@mode, keep first occurrence
+	local calls = {}
+	local deduped = {}
+	for i = 1, #headlist do
+		local key = headlist[i].callsign .. "@" .. headlist[i].mode
+		if calls[key] == nil then
+			calls[key] = true
+			table.insert(deduped, headlist[i])
+		end
+	end
+
+	-- Group by mode, keep most recent 'limit' per mode
+	local by_mode = {}
+	local mode_order = {}
+	local mode_counts = {}
+	for i = 1, #deduped do
+		local mode = deduped[i].mode
+		if not by_mode[mode] then
+			by_mode[mode] = {}
+			table.insert(mode_order, mode)
+			mode_counts[mode] = 0
+		end
+		if mode_counts[mode] < limit then
+			table.insert(by_mode[mode], deduped[i])
+			mode_counts[mode] = mode_counts[mode] + 1
+		end
+	end
+
+	return {
+		by_mode = by_mode,
+		mode_order = mode_order
+	}
+end
